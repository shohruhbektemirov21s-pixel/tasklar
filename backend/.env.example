DEBUG=1
SECRET_KEY=change-me-in-production-0123456789abcdef
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
TIME_ZONE=Asia/Tashkent

# --- IBM Db2
DB2_DB=TEAMFLOW
DB2_USER=db2inst1
DB2_PASSWORD=teamflow
DB2_HOST=db2
DB2_PORT=50000

CORS_ALLOWED_ORIGINS=http://localhost:5183,http://127.0.0.1:5183
CSRF_TRUSTED_ORIGINS=http://localhost:5183,http://localhost:8010

ADMIN_EMAIL=admin@teamflow.uz
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Bosh Admin

# Boshliq - takliflarni tasdiqlaydigan yagona rol (GlobalRole.BOSS).
# Tizim admini bu huquqqa ega emas, shuning uchun hisob alohida.
BOSS_EMAIL=boshliq@teamflow.uz
BOSS_PASSWORD=boss12345
BOSS_NAME=Boshliq

# Real-time kanal qatlami
REDIS_URL=redis://redis:6379/0

# --- Telegram Bot sozlamalari (@BotFather dan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SITE_URL=http://localhost:5183


# --- Demo ma'lumot (faqat DEBUG=1 bilan ishlaydi)
# 1 bo'lsa ishga tushishda demo hisoblar va loyihalar yaratiladi.
# Hisoblar faqat BIRINCHI marta yaratiladi, parol keyin qayta tiklanmaydi.
SEED_DEMO=0
DEMO_PASSWORD=password123

# --- Xavfsizlik va unumdorlik
# Access token umri (daqiqa). Uzun seansni refresh token ta'minlaydi.
JWT_ACCESS_MINUTES=30
# Backend oldidagi ishonchli proksilar soni (nginx - 1, proksisiz - 0).
TRUSTED_PROXIES=1
# Rejalashtiruvchi (scheduler) tekshiruv oralig'i, soniya.
SCHEDULER_INTERVAL=900
