# TeamFlow Muhit Sozlamalari (Misol)
DEBUG=0
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars
ALLOWED_HOSTS=teamflow.uz,www.teamflow.uz,localhost,127.0.0.1
TIME_ZONE=Asia/Tashkent

# --- IBM Db2
DB2_DB=TEAMFLOW
DB2_USER=db2inst1
DB2_PASSWORD=your_secure_db2_password
DB2_HOST=db2
DB2_PORT=50000

# --- CORS & CSRF
CORS_ALLOWED_ORIGINS=https://teamflow.uz,http://localhost:5183
CSRF_TRUSTED_ORIGINS=https://teamflow.uz,http://localhost:5183,http://localhost:8010

# --- Dastlabki administrator hisobi
ADMIN_EMAIL=admin@teamflow.uz
ADMIN_PASSWORD=change_admin_password_123
ADMIN_NAME=Bosh Admin

# --- Boshliq hisobi
BOSS_EMAIL=boshliq@teamflow.uz
BOSS_PASSWORD=change_boss_password_123
BOSS_NAME=Boshliq

# --- Redis & WebSocket
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# --- Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SITE_URL=https://teamflow.uz

# --- Xavfsizlik va unumdorlik
# Demo ma'lumot produksiyada HECH QACHON yoqilmaydi (DEBUG=0 da ishlamaydi ham).
SEED_DEMO=0
# Access token umri (daqiqa).
JWT_ACCESS_MINUTES=30
# Backend oldidagi ishonchli proksilar soni (nginx - 1).
TRUSTED_PROXIES=1
# uvicorn ishchilari va har biridagi fon oqimlari. Db2 ulanishlari:
# WEB_WORKERS x (1 + BACKGROUND_WORKERS) < 150 (MAXAPPLS) bo'lsin.
WEB_WORKERS=4
BACKGROUND_WORKERS=16
SCHEDULER_INTERVAL=900
